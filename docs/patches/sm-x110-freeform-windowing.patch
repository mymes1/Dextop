+        val tasks = TaskWindowingDump.tasks(2, dump)
+        assertEquals(DisplayWindowing.FULLSCREEN, TaskWindowingDump.applicationMode(tasks))
+        assertFalse(TaskWindowingDump.applicationMode(tasks).isFreeform)
+    }
+
